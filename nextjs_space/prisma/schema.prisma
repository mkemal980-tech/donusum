generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/transformation_platform/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Kullanıcı Rolleri
enum UserRole {
  USER          // Sadece anketi yanıtlayabilir
  UNIT_MANAGER  // Kendi birimindeki kullanıcıları yönetebilir
  ADMIN         // Tüm sistemi yönetebilir
}

// Birim Modeli - Lokasyon/Departman yönetimi
model Unit {
  id             String      @id @default(cuid())
  name           String
  description    String?
  organization   String?
  parentId       String?     // Üst Birim ID (Alt Birim için)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  parent         Unit?       @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subUnits       Unit[]      @relation("UnitHierarchy")
  users          User[]      @relation("UnitUsers")
  admins         UnitAdmin[] // Çoklu Admin ilişkisi
}

// Birim Admin İlişkisi - Çoklu admin desteği
model UnitAdmin {
  id        String   @id @default(cuid())
  unitId    String
  userId    String
  createdAt DateTime @default(now())
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([unitId, userId])
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  password             String
  firstName            String?
  lastName             String?
  organization         String?
  role                 UserRole          @default(USER)
  unitId               String?
  sectorId             String?
  subSectorId          String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  // Ironman Target Scores
  targetVelocity       Float?
  targetEndurance      Float?
  targetDate           DateTime?
  currentScoreDate     DateTime?
  region               String?           @default("Global")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  assessmentScores     AssessmentScore[]
  uploadedDocuments    Document[]
  roadmapItems         RoadmapItem[]
  surveyResponses      SurveyResponse[]
  sector               Sector?           @relation(fields: [sectorId], references: [id])
  subSector            SubSector?        @relation(fields: [subSectorId], references: [id])
  unit                 Unit?             @relation("UnitUsers", fields: [unitId], references: [id])
  adminOfUnits         UnitAdmin[]       // Kullanıcının admin olduğu birimler
  recommendationCompletions UserRecommendationCompletion[]
  surveyAssignments    UserSurveyAssignment[]
}

model Sector {
  id                 String              @id @default(cuid())
  name               String              @unique
  naicsCode          String?             // NAICS sektör kodu (örn: 11, 21, 22, ...)
  order              Int                 @default(0)
  createdAt          DateTime            @default(now())
  subSectors         SubSector[]
  users              User[]
  benchmarks         Benchmark[]
  ironmanBenchmarks  IronmanBenchmark[]
}

model SubSector {
  id                String              @id @default(cuid())
  name              String
  sectorId          String
  order             Int                 @default(0)
  createdAt         DateTime            @default(now())
  sector            Sector              @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  users             User[]
  benchmarks        Benchmark[]
  ironmanBenchmarks IronmanBenchmark[]

  @@unique([sectorId, name])
}

model Benchmark {
  id            String     @id @default(cuid())
  surveyId      String
  sectorId      String
  subSectorId   String?
  level         BenchmarkLevel @default(OVERALL)
  targetId      String?
  bestScore     Float      @default(0)
  averageScore  Float      @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  survey        Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  sector        Sector     @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  subSector     SubSector? @relation(fields: [subSectorId], references: [id], onDelete: Cascade)

  @@unique([surveyId, sectorId, subSectorId, level, targetId])
}

model SectorCategoryWeight {
  id         String   @id @default(cuid())
  sectorId   String
  surveyId   String
  categoryId String
  weight     Float    @default(1.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  survey     Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([sectorId, surveyId, categoryId])
}

enum BenchmarkLevel {
  OVERALL
  CATEGORY
  SUBCATEGORY
}

// Yeni Survey modeli - Çoklu anket desteği
model Survey {
  id                    String                 @id @default(cuid())
  name                  String
  description           String?
  isActive              Boolean                @default(true)
  order                 Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  categories            Category[]
  sectorCategoryWeights SectorCategoryWeight[]
  userAssignments       UserSurveyAssignment[]
  benchmarks            Benchmark[]
}

// Kullanıcı-Anket Atama Modeli
model UserSurveyAssignment {
  id         String   @id @default(cuid())
  userId     String
  surveyId   String
  assignedAt DateTime @default(now())
  assignedBy String?  // Admin ID
  isActive   Boolean  @default(true)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  survey     Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([userId, surveyId])
}

model Category {
  id            String        @id @default(cuid())
  name          String
  description   String?
  order         Int           @default(0)
  surveyId      String?
  createdAt     DateTime      @default(now())
  survey        Survey?       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  subCategories SubCategory[]
}

model SubCategory {
  id              String           @id @default(cuid())
  name            String
  description     String?
  order           Int              @default(0)
  categoryId      String
  hasSubLevels    Boolean          @default(true)
  createdAt       DateTime         @default(now())
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subLevels       SubLevel[]
  questions       Question[]       @relation("SubCategoryQuestions")
  recommendations Recommendation[]
}

model SubLevel {
  id              String           @id @default(cuid())
  name            String
  description     String?
  order           Int              @default(0)
  subCategoryId   String
  axisType        AxisType         @default(VELOCITY)
  createdAt       DateTime         @default(now())
  questions       Question[]       @relation("SubLevelQuestions")
  recommendations Recommendation[]
  subCategory     SubCategory      @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
}

// Ironman Analiz için Eksen Tipi
enum AxisType {
  VELOCITY    // X ekseni - Hız/Aksiyon
  ENDURANCE   // Y ekseni - Olgunluk/Sürdürülebilirlik
}

// Ironman Benchmark - Sektör bazlı velocity/endurance değerleri
model IronmanBenchmark {
  id                      String     @id @default(cuid())
  sectorId                String
  subSectorId             String?
  velocityAverage         Float      @default(2.5)
  velocityBest            Float      @default(4.5)
  enduranceAverage        Float      @default(2.5)
  enduranceBest           Float      @default(4.5)
  // Industry Average Targets (for next year projections)
  velocityAverageTarget   Float      @default(3.0)
  enduranceAverageTarget  Float      @default(3.0)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  sector                  Sector     @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  subSector               SubSector? @relation(fields: [subSectorId], references: [id], onDelete: Cascade)

  @@unique([sectorId, subSectorId])
}

model Question {
  id               String           @id @default(cuid())
  text             String
  type             QuestionType     @default(SCALE)
  options          Json?
  weight           Float            @default(1.0)
  requiresEvidence Boolean          @default(false)
  order            Int              @default(0)
  axisType         AxisType         @default(VELOCITY)  // Ironman için: VELOCITY (Hız) veya ENDURANCE (Olgunluk)
  subLevelId       String?
  subCategoryId    String?
  createdAt        DateTime         @default(now())
  subLevel         SubLevel?        @relation("SubLevelQuestions", fields: [subLevelId], references: [id], onDelete: Cascade)
  subCategory      SubCategory?     @relation("SubCategoryQuestions", fields: [subCategoryId], references: [id], onDelete: Cascade)
  responses        SurveyResponse[]
  recommendations  Recommendation[]
}

model SurveyResponse {
  id         String     @id @default(cuid())
  value      String
  score      Float      @default(0)
  userId     String
  questionId String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  documents  Document[]
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model Document {
  id               String          @id @default(cuid())
  fileName         String
  fileType         String
  cloudStoragePath String
  isPublic         Boolean         @default(false)
  userId           String
  responseId       String?
  createdAt        DateTime        @default(now())
  response         SurveyResponse? @relation(fields: [responseId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssessmentScore {
  id             String   @id @default(cuid())
  totalScore     Float
  categoryScores Json
  assessmentDate DateTime @default(now())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id                String        @id @default(cuid())
  title             String
  description       String
  videoUrl          String?       // Vimeo veya YouTube video linki - "Nasıl Yapılır Öğrenin"
  categoryId        String?
  subCategoryId     String?       // Alt kategoriye direkt bağlantı
  subLevelId        String?
  // Soru-Cevap Bazlı Tetikleme
  questionId        String?       // Bağlı soru
  triggerOptions    String?       // JSON: Tetikleyici cevaplar (örn: ["yok", "planliyoruz"])
  // Gelişim Skoru için Puan
  points            Float         @default(0.5)  // Öneri tamamlandığında eklenecek puan (0-5 arası)
  costType          CostType      @default(OPEX)
  timeframe         Timeframe     @default(MEDIUM_TERM)
  strategicType     StrategicType @default(PROJECT)
  estimatedImpact   Float         @default(0)
  minScoreThreshold Float         @default(0)
  maxScoreThreshold Float         @default(100)
  order             Int           @default(0)
  // Bubble Chart için yeni alanlar
  xPosition         Float         @default(5)   // X ekseni: 1-10 (Kaynak → Önem → Aciliyet)
  yPosition         Float         @default(5)   // Y ekseni: 1-10 (Öncelik puanı)
  capexLevel        Int           @default(1)   // CAPEX maliyeti: 1-5 ($ işaretleri)
  opexLevel         Int           @default(1)   // Yıllık OPEX maliyeti: 1-5 ($ işaretleri)
  createdAt         DateTime      @default(now())
  roadmapItems      RoadmapItem[]
  question          Question?     @relation(fields: [questionId], references: [id], onDelete: SetNull)
  subCategory       SubCategory?  @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  subLevel          SubLevel?     @relation(fields: [subLevelId], references: [id], onDelete: SetNull)
  completions       UserRecommendationCompletion[]
}

// Kullanıcının öneri tamamlama durumunu takip eden model
enum CompletionStatus {
  NOT_STARTED     // Başlanmadı
  IN_PROGRESS     // Devam Ediyor
  COMPLETED       // Tamamlandı
}

model UserRecommendationCompletion {
  id               String           @id @default(cuid())
  userId           String
  recommendationId String
  status           CompletionStatus @default(NOT_STARTED)
  notes            String?          // Kullanıcı notları
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation   Recommendation   @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@unique([userId, recommendationId])
}

// Skor Geçmişi - Zaman içindeki gelişimi takip etmek için
model ScoreHistory {
  id                  String    @id @default(cuid())
  userId              String
  surveyId            String?
  // Genel Skorlar
  overallScore        Float     // 1-5 ölçeğinde genel puan
  overallPercentage   Float     // %0-100 yüzdelik değer
  // Ironman Skorları
  velocityScore       Float?
  enduranceScore      Float?
  quadrant            String?   // WALKER, SPRINTER, MARATHON_RUNNER, IRONMAN
  // Meta Veriler
  completedQuestions  Int       @default(0)
  totalQuestions      Int       @default(0)
  completedRecommendations Int  @default(0)
  // Tetikleyen Olay
  triggerType         String    // SURVEY_RESPONSE, RECOMMENDATION_COMPLETED, MANUAL_SNAPSHOT
  triggerEntityId     String?   // İlgili entity ID (öneri veya soru)
  // Zaman Damgası
  recordedAt          DateTime  @default(now())

  @@index([userId, recordedAt])
  @@index([userId, surveyId, recordedAt])
}

model RoadmapItem {
  id               String         @id @default(cuid())
  userId           String
  recommendationId String
  priority         Int            @default(0)
  plannedQuarter   Int?
  plannedYear      Int?
  status           RoadmapStatus  @default(NOT_STARTED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recommendationId])
}

enum QuestionType {
  SCALE
  YES_NO
  MULTIPLE_CHOICE
}

enum CostType {
  CAPEX
  OPEX
}

enum Timeframe {
  SHORT_TERM
  MEDIUM_TERM
  LONG_TERM
}

enum StrategicType {
  QUICK_WIN
  BIG_BET
  PROJECT
}

enum RoadmapStatus {
  NOT_STARTED   // Başlanmadı - Skora katkı: 0
  IN_PROGRESS   // Devam Ediyor - Skora katkı: %50
  COMPLETED     // Tamamlandı - Skora katkı: %100
  PLANNED       // Planlandı (eski durum)
  CANCELLED     // İptal
}
