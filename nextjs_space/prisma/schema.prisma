generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/transformation_platform/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  password          String
  firstName         String?
  lastName          String?
  organization      String?
  sectorId          String?
  subSectorId       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  assessmentScores  AssessmentScore[]
  uploadedDocuments Document[]
  roadmapItems      RoadmapItem[]
  surveyResponses   SurveyResponse[]
  sector            Sector?           @relation(fields: [sectorId], references: [id])
  subSector         SubSector?        @relation(fields: [subSectorId], references: [id])
}

model Sector {
  id          String      @id @default(cuid())
  name        String      @unique
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  subSectors  SubSector[]
  users       User[]
  benchmarks  Benchmark[]
}

model SubSector {
  id         String      @id @default(cuid())
  name       String
  sectorId   String
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  sector     Sector      @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  users      User[]
  benchmarks Benchmark[]

  @@unique([sectorId, name])
}

model Benchmark {
  id            String     @id @default(cuid())
  sectorId      String
  subSectorId   String?
  level         BenchmarkLevel @default(OVERALL)
  targetId      String?
  bestScore     Float      @default(0)
  averageScore  Float      @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sector        Sector     @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  subSector     SubSector? @relation(fields: [subSectorId], references: [id], onDelete: Cascade)

  @@unique([sectorId, subSectorId, level, targetId])
}

model SectorCategoryWeight {
  id         String   @id @default(cuid())
  sectorId   String
  categoryId String
  weight     Float    @default(1.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sectorId, categoryId])
}

enum BenchmarkLevel {
  OVERALL
  CATEGORY
  SUBCATEGORY
}

model Category {
  id            String        @id @default(cuid())
  name          String
  description   String?
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  subCategories SubCategory[]
}

model SubCategory {
  id          String     @id @default(cuid())
  name        String
  description String?
  order       Int        @default(0)
  categoryId  String
  createdAt   DateTime   @default(now())
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subLevels   SubLevel[]
}

model SubLevel {
  id              String           @id @default(cuid())
  name            String
  description     String?
  order           Int              @default(0)
  subCategoryId   String
  createdAt       DateTime         @default(now())
  questions       Question[]
  recommendations Recommendation[]
  subCategory     SubCategory      @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
}

model Question {
  id               String           @id @default(cuid())
  text             String
  type             QuestionType     @default(SCALE)
  options          Json?
  weight           Float            @default(1.0)
  requiresEvidence Boolean          @default(false)
  order            Int              @default(0)
  subLevelId       String
  createdAt        DateTime         @default(now())
  subLevel         SubLevel         @relation(fields: [subLevelId], references: [id], onDelete: Cascade)
  responses        SurveyResponse[]
}

model SurveyResponse {
  id         String     @id @default(cuid())
  value      String
  score      Float      @default(0)
  userId     String
  questionId String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  documents  Document[]
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model Document {
  id               String          @id @default(cuid())
  fileName         String
  fileType         String
  cloudStoragePath String
  isPublic         Boolean         @default(false)
  userId           String
  responseId       String?
  createdAt        DateTime        @default(now())
  response         SurveyResponse? @relation(fields: [responseId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssessmentScore {
  id             String   @id @default(cuid())
  totalScore     Float
  categoryScores Json
  assessmentDate DateTime @default(now())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id                String        @id @default(cuid())
  title             String
  description       String
  categoryId        String?
  subLevelId        String?
  costType          CostType      @default(OPEX)
  timeframe         Timeframe     @default(MEDIUM_TERM)
  strategicType     StrategicType @default(PROJECT)
  estimatedImpact   Float         @default(0)
  minScoreThreshold Float         @default(0)
  maxScoreThreshold Float         @default(100)
  order             Int           @default(0)
  createdAt         DateTime      @default(now())
  roadmapItems      RoadmapItem[]
  subLevel          SubLevel?     @relation(fields: [subLevelId], references: [id], onDelete: SetNull)
}

model RoadmapItem {
  id               String         @id @default(cuid())
  userId           String
  recommendationId String
  priority         Int            @default(0)
  plannedQuarter   Int?
  plannedYear      Int?
  status           RoadmapStatus  @default(PLANNED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recommendationId])
}

enum QuestionType {
  SCALE
  YES_NO
  MULTIPLE_CHOICE
}

enum CostType {
  CAPEX
  OPEX
}

enum Timeframe {
  SHORT_TERM
  MEDIUM_TERM
  LONG_TERM
}

enum StrategicType {
  QUICK_WIN
  BIG_BET
  PROJECT
}

enum RoadmapStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
