generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Unit {
  id           String      @id @default(cuid())
  name         String
  description  String?
  organization String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  parentId     String?
  parent       Unit?       @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subUnits     Unit[]      @relation("UnitHierarchy")
  admins       UnitAdmin[]
  assessments  Assessment[]
  users        User[]      @relation("UnitUsers")
}

model UnitAdmin {
  id        String   @id @default(cuid())
  unitId    String
  userId    String
  createdAt DateTime @default(now())
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([unitId, userId])
}

model User {
  id                        String                         @id @default(cuid())
  email                     String                         @unique
  password                  String
  firstName                 String?
  lastName                  String?
  organization              String?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  sectorId                  String?
  subSectorId               String?
  passwordResetExpires      DateTime?
  passwordResetToken        String?
  role                      UserRole                       @default(USER)
  unitId                    String?
  currentScoreDate          DateTime?
  region                    String?                        @default("Global")
  targetDate                DateTime?
  targetEndurance           Float?
  targetVelocity            Float?
  emailVerificationExpires  DateTime?
  emailVerificationToken    String?
  emailVerified             Boolean                        @default(false)
  isActive                  Boolean                        @default(true)
  assessmentScores          AssessmentScore[]
  uploadedDocuments         Document[]
  authoredResponses         SurveyResponse[]               @relation("ResponseAuthor")
  ownedAssessments          Assessment[]                   @relation("AssessmentOwner")
  adminOfUnits              UnitAdmin[]
  sector                    Sector?                        @relation(fields: [sectorId], references: [id])
  subSector                 SubSector?                     @relation(fields: [subSectorId], references: [id])
  unit                      Unit?                          @relation("UnitUsers", fields: [unitId], references: [id])
  surveyAssignments         UserSurveyAssignment[]
  assignedSections          SectionAssignment[]            @relation("SectionAssignee")
  distributedSections       SectionAssignment[]            @relation("SectionAssigner")
}

model Sector {
  id                String             @id @default(cuid())
  name              String             @unique
  order             Int                @default(0)
  createdAt         DateTime           @default(now())
  naicsCode         String?
  benchmarks        Benchmark[]
  ironmanBenchmarks IronmanBenchmark[]
  subSectors        SubSector[]
  users             User[]
  scopeRules        SectorScopeRule[]
}

model SubSector {
  id                String             @id @default(cuid())
  name              String
  sectorId          String
  order             Int                @default(0)
  createdAt         DateTime           @default(now())
  benchmarks        Benchmark[]
  ironmanBenchmarks IronmanBenchmark[]
  sector            Sector             @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  users             User[]
  scopeRules        SectorScopeRule[]

  @@unique([sectorId, name])
}

model Benchmark {
  id           String         @id @default(cuid())
  sectorId     String
  subSectorId  String?
  level        BenchmarkLevel @default(OVERALL)
  targetId     String?
  bestScore    Float          @default(0)
  averageScore Float          @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  surveyId     String
  sector       Sector         @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  subSector    SubSector?     @relation(fields: [subSectorId], references: [id], onDelete: Cascade)
  survey       Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, sectorId, subSectorId, level, targetId])
}

/// Sektör × bölüm kapsam ve ağırlık kuralı.
///
/// Kayıt yoksa varsayılan geçerlidir: bölüm kapsamdadır ve ağırlığı 1'dir.
/// Bu bilinçli — yeni eklenen bir bölüm hiçbir sektörde kaybolmasın diye.
///
/// subSectorId null ise kural sektörün tamamı için geçerlidir; dolu ise
/// yalnızca o alt sektör için geçerli olup sektör genelini ezer.
model SectorScopeRule {
  id            String      @id @default(cuid())
  sectorId      String
  subSectorId   String?
  surveyId      String
  subCategoryId String
  /// false ise bölüm o sektöre hiç sorulmaz ve puana girmez.
  applicable    Boolean     @default(true)
  /// Kapsamdaki bölümün göreli ağırlığı (0.5 az, 1 orta, 2 çok önemli).
  weight        Float       @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sector        Sector      @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  subSector     SubSector?  @relation(fields: [subSectorId], references: [id], onDelete: Cascade)
  survey        Survey      @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@unique([sectorId, subSectorId, surveyId, subCategoryId])
  @@index([surveyId, sectorId])
}

model Survey {
  id                    String                 @id @default(cuid())
  name                  String
  description           String?
  isActive              Boolean                @default(true)
  order                 Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  archivedAt            DateTime?              // Soft-delete: doluysa arşivlenmiş sayılır
  benchmarks            Benchmark[]
  categories            Category[]
  sectorScopeRules      SectorScopeRule[]
  assessments           Assessment[]
  userAssignments       UserSurveyAssignment[]
  aiRecommendationCache AIRecommendationCache[]
}

model UserSurveyAssignment {
  id                  String    @id @default(cuid())
  userId              String
  surveyId            String
  assignedAt          DateTime  @default(now())
  assignedBy          String?
  isActive            Boolean   @default(true)
  // Süre sınırı özellikleri
  hasDeadline         Boolean   @default(false)  // Süre sınırı aktif mi?
  deadline            DateTime?                   // Bitiş tarihi
  deadlineExtendedAt  DateTime?                   // Süre uzatma tarihi
  deadlineExtendedBy  String?                     // Süreyi uzatan admin
  survey              Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, surveyId])
}

model Category {
  id            String        @id @default(cuid())
  name          String
  description   String?
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  archivedAt    DateTime?     // Soft-delete
  surveyId      String?
  survey        Survey?       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  subCategories SubCategory[]
  questions     Question[]    @relation("CategoryQuestions")
}

model SubCategory {
  id              String           @id @default(cuid())
  name            String
  description     String?
  order           Int              @default(0)
  categoryId      String
  createdAt       DateTime         @default(now())
  archivedAt      DateTime?        // Soft-delete
  hasSubLevels    Boolean          @default(true)
  questions       Question[]       @relation("SubCategoryQuestions")
  recommendations Recommendation[]
  scopeRules      SectorScopeRule[]
  assignments     SectionAssignment[]
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subLevels       SubLevel[]
}

model SubLevel {
  id              String           @id @default(cuid())
  name            String
  description     String?
  order           Int              @default(0)
  subCategoryId   String
  createdAt       DateTime         @default(now())
  archivedAt      DateTime?        // Soft-delete
  axisType        AxisType         @default(VELOCITY)
  questions       Question[]       @relation("SubLevelQuestions")
  recommendations Recommendation[]
  subCategory     SubCategory      @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
}

model IronmanBenchmark {
  id                     String     @id @default(cuid())
  sectorId               String
  subSectorId            String?
  velocityAverage        Float      @default(2.5)
  velocityBest           Float      @default(4.5)
  enduranceAverage       Float      @default(2.5)
  enduranceBest          Float      @default(4.5)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  enduranceAverageTarget Float      @default(3.0)
  velocityAverageTarget  Float      @default(3.0)
  sector                 Sector     @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  subSector              SubSector? @relation(fields: [subSectorId], references: [id], onDelete: Cascade)

  @@unique([sectorId, subSectorId])
}

model Question {
  id                 String           @id @default(cuid())
  text               String
  type               QuestionType     @default(SCALE)
  options            Json?
  weight             Float            @default(1.0)
  requiresEvidence   Boolean          @default(false)
  order              Int              @default(0)
  subLevelId         String?
  createdAt          DateTime         @default(now())
  subCategoryId      String?
  categoryId         String?
  axisType           AxisType         @default(VELOCITY)
  conditionalOptions Json?
  archivedAt         DateTime?        // Soft-delete
  category           Category?        @relation("CategoryQuestions", fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory        SubCategory?     @relation("SubCategoryQuestions", fields: [subCategoryId], references: [id], onDelete: Cascade)
  subLevel           SubLevel?        @relation("SubLevelQuestions", fields: [subLevelId], references: [id], onDelete: Cascade)
  recommendations    Recommendation[]
  responses          SurveyResponse[]
}

/// Bir kuruluşun bir ankete verdiği değerlendirme.
///
/// Değerlendirmenin sahibi kişi değil kuruluştur: büyük bir şirkette farklı
/// bölümleri farklı departmanlar doldurur ve ortaya tek bir kurumsal puan
/// çıkması gerekir. Cevaplar, yol haritası ve puan geçmişi bu nesneye bağlıdır.
///
/// Kuruluşu olmayan kullanıcı için tek kişilik değerlendirme açılır
/// (unitId null, ownerUserId dolu); davranış bugünküyle aynı kalır.
model Assessment {
  id           String           @id @default(cuid())
  surveyId     String
  unitId       String?
  ownerUserId  String?
  status       AssessmentStatus @default(IN_PROGRESS)
  submittedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  survey       Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  unit         Unit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  owner        User?            @relation("AssessmentOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  responses    SurveyResponse[]
  roadmapItems RoadmapItem[]
  scoreHistory ScoreHistory[]
  sectionAssignments SectionAssignment[]

  @@unique([surveyId, unitId])
  @@unique([surveyId, ownerUserId])
}

/// Bir bölümün (alt kategori) sorumlusu.
///
/// Değerlendirmeyi kuruluş doldurunca sıradaki soru "kim neyi dolduracak"
/// oluyor. Dağıtım bölüm düzeyindedir: kategori çok kaba, soru çok ince.
///
/// @@unique bir bölümün tek kişiye ait olmasını veritabanı düzeyinde garanti
/// eder — iki sorumlu, aynı soruya iki cevap ve bir çatışma çözümü başlığı
/// demekti. Kayıt yokluğu "bu bölüm henüz dağıtılmadı" anlamına gelir ve
/// bölüm koordinatörde kalır.
model SectionAssignment {
  id            String      @id @default(cuid())
  assessmentId  String
  subCategoryId String
  assigneeId    String
  /// Denetim izi: görevi dağıtan koordinatör.
  assignedById  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  assessment    Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  assignee      User        @relation("SectionAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignedBy    User?       @relation("SectionAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([assessmentId, subCategoryId])
  @@index([assessmentId, assigneeId])
}

enum AssessmentStatus {
  IN_PROGRESS
  SUBMITTED
}

model SurveyResponse {
  id           String     @id @default(cuid())
  value        String
  score        Float      @default(0)
  assessmentId String
  questionId   String
  /// Denetim izi: cevabı kimin girdiği. Puanlamada kullanılmaz.
  answeredById String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  documents    Document[]
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answeredBy   User?      @relation("ResponseAuthor", fields: [answeredById], references: [id], onDelete: SetNull)

  @@unique([assessmentId, questionId])
}

model Document {
  id               String          @id @default(cuid())
  fileName         String
  fileType         String
  cloudStoragePath String
  isPublic         Boolean         @default(false)
  userId           String
  responseId       String?
  createdAt        DateTime        @default(now())
  response         SurveyResponse? @relation(fields: [responseId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssessmentScore {
  id             String   @id @default(cuid())
  totalScore     Float
  categoryScores Json
  assessmentDate DateTime @default(now())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id                String                         @id @default(cuid())
  title             String
  description       String
  categoryId        String?
  costType          CostType                       @default(OPEX)
  timeframe         Timeframe                      @default(MEDIUM_TERM)
  strategicType     StrategicType                  @default(PROJECT)
  estimatedImpact   Float                          @default(0)
  minScoreThreshold Float                          @default(0)
  maxScoreThreshold Float                          @default(100)
  order             Int                            @default(0)
  createdAt         DateTime                       @default(now())
  subLevelId        String?
  capexLevel        Int                            @default(1)
  opexLevel         Int                            @default(1)
  xPosition         Float                          @default(5)
  yPosition         Float                          @default(5)
  subCategoryId     String?
  questionId        String?
  triggerOptions    String?
  // Kademeli tetikleme: doluysa öneri, kullanıcının bu soruya verdiği cevabın
  // puanı bu değere eşit veya altındaysa gösterilir. Böylece daha düşük
  // basamaktaki kullanıcılar üst basamakların önerilerini de devralır.
  // Null ise `triggerOptions` ile tam eşleşme uygulanır (eski davranış).
  triggerMaxAnswerScore Float?
  points            Float                          @default(0.5)
  videoUrl          String?
  question          Question?                      @relation(fields: [questionId], references: [id])
  subCategory       SubCategory?                   @relation(fields: [subCategoryId], references: [id])
  subLevel          SubLevel?                      @relation(fields: [subLevelId], references: [id])
  roadmapItems      RoadmapItem[]
}

model ScoreHistory {
  id                       String   @id @default(cuid())
  assessmentId             String
  surveyId                 String?
  overallScore             Float
  overallPercentage        Float
  velocityScore            Float?
  enduranceScore           Float?
  quadrant                 String?
  completedQuestions       Int      @default(0)
  totalQuestions           Int      @default(0)
  completedRecommendations Int      @default(0)
  triggerType              String
  triggerEntityId          String?
  recordedAt               DateTime @default(now())
  assessment               Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, recordedAt])
  @@index([assessmentId, surveyId, recordedAt])
}

model RoadmapItem {
  id               String         @id @default(cuid())
  assessmentId     String
  recommendationId String
  priority         Int            @default(0)
  plannedQuarter   Int?
  plannedYear      Int?
  status           RoadmapStatus  @default(NOT_STARTED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  assessment       Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, recommendationId])
}

enum UserRole {
  USER
  UNIT_MANAGER
  ADMIN
}

enum BenchmarkLevel {
  OVERALL
  CATEGORY
  SUBCATEGORY
}

enum AxisType {
  VELOCITY
  ENDURANCE
}

enum CompletionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum QuestionType {
  SCALE
  YES_NO
  MULTIPLE_CHOICE
  CONDITIONAL_CHOICE
}

enum CostType {
  CAPEX
  OPEX
}

enum Timeframe {
  SHORT_TERM
  MEDIUM_TERM
  LONG_TERM
}

enum StrategicType {
  QUICK_WIN
  BIG_BET
  PROJECT
}

enum RoadmapStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NOT_STARTED
}


// AI Recommendation Cache - Batch + Cache yaklaşımı için
model AIRecommendationCache {
  id              String   @id @default(cuid())
  profileHash     String   @unique  // Sektör + puan profili hash'i
  surveyId        String
  recommendations Json     // AI sonuçları: [{id, priority, note}]
  createdAt       DateTime @default(now())
  expiresAt       DateTime // TTL - 24 saat sonra

  survey          Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}
// System Health Monitoring
model HealthLog {
  id            String   @id @default(cuid())
  status        String   // healthy, degraded, unhealthy
  dbLatency     Int?     // ms
  memoryUsage   Int?     // percentage
  responseTime  Int?     // ms
  errorMessage  String?
  checkedAt     DateTime @default(now())

  @@index([checkedAt])
  @@index([status])
}
