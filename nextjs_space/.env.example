# Railway app service: set this as a reference variable to ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXTAUTH_URL="https://your-domain.up.railway.app"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

RESEND_API_KEY="re_replace_with_resend_api_key"
EMAIL_FROM="Donusum Platformu <noreply@example.com>"

S3_ENDPOINT="https://your-railway-bucket-endpoint"
S3_REGION="auto"
S3_BUCKET="your-bucket-name"
S3_ACCESS_KEY_ID="replace-with-storage-access-key"
S3_SECRET_ACCESS_KEY="replace-with-storage-secret-key"
S3_FORCE_PATH_STYLE="true"
S3_FOLDER_PREFIX=""
S3_PUBLIC_BASE_URL=""

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4.1-mini"
